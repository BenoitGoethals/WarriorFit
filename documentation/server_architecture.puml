@startuml Bensoft.be Server Architecture

skinparam componentStyle rectangle
skinparam linetype ortho

skinparam component {
    BackgroundColor<<internet>> #e74c3c
    BackgroundColor<<router>> #f39c12
    BackgroundColor<<server>> #9b59b6
    BackgroundColor<<nginx>> #27ae60
    BackgroundColor<<docker>> #3498db
    BorderColor Black
    FontColor White
}

skinparam package {
    BackgroundColor #f8f9fa
    BorderColor #2c3e50
    FontColor #2c3e50
    FontSize 14
    FontStyle bold
}

skinparam note {
    BackgroundColor #fff3cd
    BorderColor #f39c12
}

title Bensoft.be Server Architectuur\nNginx Reverse Proxy met SSL/TLS en Docker Containers

' Layer 1: Internet & DNS
package "Layer 1: Internet & DNS" {
    component "🌍 Publiek Toegangspunt\n\nPubliek IP: 78.21.255.210\n\nDNS Records:\nbensoft.be → 78.21.255.210\nwww.bensoft.be → 78.21.255.210\napi.bensoft.be → 78.21.255.210" as internet <<internet>>

    component "👥 Gebruikers\n\nhttps://bensoft.be\nhttps://www.bensoft.be\nhttps://api.bensoft.be" as users <<internet>>
}

' Layer 2: Router & Firewall
package "Layer 2: Router & Firewall" {
    component "📡 Port Forwarding\n\nPoort 80 (HTTP) → 192.168.0.30:80\nPoort 443 (HTTPS) → 192.168.0.30:443" as portforward <<router>>

    component "🛡️ Netwerk\n\nVan: 78.21.255.210\nNaar: 192.168.0.x\n\nAlleen poort 80 en 443" as network <<router>>
}

' Layer 3: Ubuntu Server
package "Layer 3: Ubuntu Server 25.10" {
    component "💻 Server Details\n\nIP: 192.168.0.30\nOS: Ubuntu Server 25.10\nServices: Nginx, Docker, UFW" as server <<server>>

    component "🔥 UFW Firewall\n\nNginx Full (80, 443)\nOpenSSH (22)\n192.168.0.0/24" as ufw <<server>>
}

' Layer 4: Nginx Reverse Proxy
package "Layer 4: Nginx Reverse Proxy" {
    component "🔐 SSL/TLS Terminatie\n\nLet's Encrypt Certificaten\nHTTP → HTTPS redirect\nTLS 1.2 & 1.3\nAuto-renewal elke 60 dagen\n\n/etc/letsencrypt/live/bensoft.be/" as ssl <<nginx>>

    component "🎯 Routing Logic\n\nbensoft.be → localhost:8500\nwww.bensoft.be → localhost:8500\napi.bensoft.be → localhost:8550\n\n/etc/nginx/sites-available/bensoft.be" as routing <<nginx>>

    component "📝 Proxy Headers\n\nX-Real-IP\nX-Forwarded-For\nX-Forwarded-Proto\nHost\nWebSocket support" as headers <<nginx>>
}

' Layer 5: Docker Containers
package "Layer 5: Docker Containers" {
    component "📦 Hoofdapplicatie\n\nPoort: localhost:8500\nServer: uvicorn\n\nhttps://bensoft.be\nhttps://www.bensoft.be\n\n⚠️ Alleen localhost" as mainapp <<docker>>

    component "📦 API\n\nPoort: localhost:8550\n\nhttps://api.bensoft.be\n\n⚠️ Alleen localhost" as api <<docker>>

    component "📦 Mail (Optioneel)\n\nPoort: localhost:8025\nStatus: Klaar voor gebruik\n\nToekomstig: mail.bensoft.be" as mail <<docker>>
}

' Request Flow
users -down-> internet : "HTTPS Request"
internet -down-> portforward : "Port 443"
portforward -down-> network
network -down-> server : "192.168.0.30:443"
server -down-> ufw : "Check Firewall"
ufw -down-> ssl : "Allow Traffic"
ssl -down-> routing : "Decrypt & Route"
routing -down-> headers
headers -down-> mainapp : "bensoft.be\nwww.bensoft.be"
headers -down-> api : "api.bensoft.be"

' Request Flow Steps Note
note right of users
    **🔄 Request Flow:**
    1️⃣ Gebruiker opent https://bensoft.be
    2️⃣ DNS resolveert naar 78.21.255.210
    3️⃣ Router forwardt naar 192.168.0.30:443
    4️⃣ UFW controleert en staat toe
    5️⃣ Nginx decrypts SSL
    6️⃣ Nginx route naar localhost:8500
    7️⃣ Docker container verwerkt request
    8️⃣ Response via Nginx → Router → User ✓
end note

' Security Note
note left of ssl
    **🔒 Beveiligingslagen:**
    • SSL/TLS Encryptie
    • HTTP → HTTPS redirect
    • UFW Firewall
    • Docker Isolatie
    • Let's Encrypt certificaten
end note

' Technical Specs Note
note bottom of mainapp
    **⚙️ Tech Stack:**
    • Nginx 1.24.0
    • Ubuntu Server 25.10
    • Docker Containers
    • Let's Encrypt
    • TLS 1.2/1.3
    • HTTP/1.1, HTTP/2
end note

@enduml
