@startuml
actor PTI
participant "UI (Shiny)" as UI
participant "Controller" as Ctrl
participant "Service (Validation & Calculation)" as Service
participant "Repository / Database" as DB
participant "Event Queue" as Queue
participant "Mailservice" as Mail
participant "HRM REST API" as HRM


PTI -> UI: Select PHEF session
UI -> Ctrl: requestSession(session_id)
Ctrl -> DB: fetchSession(session_id)
DB --> Ctrl: sessionData
Ctrl --> UI: showSession



PTI -> UI: Enter stamnummer
UI -> Ctrl: lookupMilitair(stamnummer)
Ctrl -> HRM: GET /hrm/militair/{stamnummer}
alt militair found
HRM --> Ctrl: militairData
Ctrl --> UI: showMilitair(militairData)
else not found
HRM --> Ctrl: 404
Ctrl --> UI: showError("Militair niet gevonden")
end


PTI -> UI: Enter 2400m time, sidebridge L/R, remarks
UI -> Ctrl: submitMeasurements(payload)
Ctrl -> Service: validateAndCalculate(payload)
Service -> Service: validateFormat()
alt validation fail
Service --> Ctrl: validationErrors
Ctrl --> UI: showValidationErrors
end
Service -> Service: computeScore(age,gender,values)
Service --> Ctrl: result(score,passed)
Ctrl -> DB: saveResult(result, audit)
DB --> Ctrl: saveAck(result_id)
Ctrl -> UI: showConfirmation(result_id, score, passed)


note over Ctrl,Queue: enqueue background tasks
Ctrl -> Queue: enqueue(emailTask(result_id, email))
Ctrl -> Queue: enqueue(hrmPushTask(result_id))


Queue -> Mail: sendEmail(result_id, email)
Mail --> Queue: emailAck(status)


Queue -> HRM: POST /api/hrm/phefresults {json}
HRM --> Queue: 200 OK


UI --> PTI: "Resultaat opgeslagen (id: result_id)"


@enduml