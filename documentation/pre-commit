#!/bin/sh
# pre-commit hook
# Automatically updates version.yaml before each commit

YAML_FILE="version.yaml"
REPO_ROOT=$(git rev-parse --show-toplevel)
YAML_PATH="$REPO_ROOT/$YAML_FILE"

# Get current date
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Get current version from yaml, default to 0.0.0 if not found
if [ -f "$YAML_PATH" ]; then
  CURRENT_VERSION=$(grep -oP 'version:\s*\K[0-9]+\.[0-9]+\.[0-9]+' "$YAML_PATH")
else
  CURRENT_VERSION="0.0.0"
fi

# If no version found, set to 0.0.0
if [ -z "$CURRENT_VERSION" ]; then
  CURRENT_VERSION="0.0.0"
fi

# Split version into major.minor.patch
MAJOR=$(echo $CURRENT_VERSION | cut -d. -f1)
MINOR=$(echo $CURRENT_VERSION | cut -d. -f2)
PATCH=$(echo $CURRENT_VERSION | cut -d. -f3)

# Increment patch version
PATCH=$((PATCH + 1))

# New version
NEW_VERSION="$MAJOR.$MINOR.$PATCH"

# Total commit count (will be +1 after this commit)
COMMIT_COUNT=$(($(git rev-list --count HEAD) + 1))

# Get short commit hash of HEAD (previous commit)
COMMIT_HASH=$(git rev-parse --short HEAD)

# Write updated yaml file
cat > "$YAML_PATH" <<EOFINNER
# Auto-generated by pre-commit hook
# Do not edit manually

version: $NEW_VERSION
date: "$DATE"
commit_count: $COMMIT_COUNT
commit_hash: $COMMIT_HASH
EOFINNER

# Stage the updated yaml file to be included in this commit
git add "$YAML_PATH"

echo "✓ Version updated to $NEW_VERSION and staged for commit"

# Exit 0 to allow commit to proceed
exit 0
